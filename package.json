{
  "name": "FindPhotosOfMe",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "deploy": "bun --filter @FindPhotosOfMe/backend deploy && bun run deploy:modal && bun --filter web deploy",
    "deploy:modal": "uv tool run --from modal==1.6.0 modal deploy python/modal_app.py",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F @FindPhotosOfMe/backend dev",
    "dev:setup": "turbo -F @FindPhotosOfMe/backend dev:setup"
  },
  "devDependencies": {
    "turbo": "^2.11.7",
    "wrangler": "^4.147.0"
  },
  "packageManager": "bun@1.4.2",
  "dependencies": {}
}
