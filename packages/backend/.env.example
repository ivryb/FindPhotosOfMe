SITE_URL=http://localhost:3001
# Explicit additional frontend origins, e.g. the Worker preview and local development.
ADDITIONAL_TRUSTED_ORIGINS=
CONVEX_SITE_URL=https://your-deployment.convex.site
BETTER_AUTH_SECRET=generate-a-long-random-secret

CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_EMAIL_API_TOKEN=token-with-email-sending-edit
AUTH_EMAIL_FROM=sign-in@example.com
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Creem: a test key (creem_test_...) uses the sandbox; product and webhook secret must come from the same mode.
CREEM_API_KEY=creem_test_your-key
CREEM_PRODUCT_ID=prod_your-credit-product
CREEM_WEBHOOK_SECRET=whsec_from-the-webhook-endpoint

PYTHON_API_URL=http://localhost:8000
SERVICE_TOKEN=use-the-same-long-random-value-as-nuxt-and-python
LEGACY_OWNER_EMAIL=you@example.com
TELEGRAM_WEBHOOK_BASE_URL=https://example.com/api/telegram

# Telegram search continuations sign matching photos directly from Convex.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET_NAME=your-bucket
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
